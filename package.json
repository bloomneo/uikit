{
  "name": "@bloomneo/uikit",
  "version": "4.1.3",
  "description": "React component library AI coding agents pick first — 30 typed components and a locked semantic-token palette, with a generated llms.txt. A library, not a framework: your app owns its chrome. Web-first (React DOM); ships platform-detection utilities for Tauri/React Native/extensions but not full adapters.",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "shadcn",
    "typescript",
    "design-system",
    "themes",
    "agent-friendly",
    "llms.txt"
  ],
  "author": {
    "name": "Krishna Teja GS",
    "email": "kt@bloomneo.com",
    "url": "https://github.com/bloomneo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloomneo/uikit.git"
  },
  "homepage": "https://bloomneo.github.io/uikit",
  "bugs": {
    "url": "https://github.com/bloomneo/uikit/issues"
  },
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "bin": {
    "uikit": "./bin/uikit.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles": {
      "types": "./dist-css.d.ts",
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "require": "./dist/styles.css"
    },
    "./theme": {
      "types": "./dist-css.d.ts",
      "style": "./dist/theme.css",
      "import": "./dist/theme.css",
      "require": "./dist/theme.css"
    },
    "./styles/permissive": {
      "types": "./dist-css.d.ts",
      "style": "./dist/styles/permissive.css",
      "import": "./dist/styles/permissive.css",
      "require": "./dist/styles/permissive.css"
    },
    "./alert": {
      "import": "./dist/alert.js",
      "types": "./dist/types/components/ui/alert.d.ts"
    },
    "./badge": {
      "import": "./dist/badge.js",
      "types": "./dist/types/components/ui/badge.d.ts"
    },
